{
  "id": "./ops.html",
  "name": "ViTrox Ops",
  "short_name": "ViTrox Ops",
  "description": "Memory rack, returns, trace, tasks and dashboards from the ISSUE SHEET.",
  "start_url": "./ops.html",
  "scope": "./ops.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0a0e17",
  "theme_color": "#0a0e17",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Memory Rack", "url": "./ops.html#rack", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "./ops.html#tasks", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Dashboards", "url": "./ops.html#dash", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
